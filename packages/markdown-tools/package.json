{
  "name": "@agloom/markdown-tools",
  "version": "0.0.1",
  "description": "Markdown formatting and linting tools for agloom",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "lint": "eslint .",
    "fmt": "prettier --write \"src/**/*.ts\"",
    "fmt:check": "prettier --check \"src/**/*.ts\""
  },
  "dependencies": {
    "markdownlint-cli2": "^0.17.2",
    "prettier": "^3.5.3",
    "prettier-plugin-toml": "^2.0.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.58.0",
    "vitest": "^3.1.1"
  }
}
