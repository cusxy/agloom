{
  "name": "agloom",
  "version": "0.5.1",
  "description": "Transpile canonical agent configurations across AI coding assistants (Claude Code, OpenCode, Agents.md, and more)",
  "type": "module",
  "packageManager": "pnpm@10.29.1",
  "license": "Apache-2.0",
  "author": "Nikita Gorbunov <cusxies@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cusxy/agloom.git"
  },
  "homepage": "https://github.com/cusxy/agloom",
  "bugs": {
    "url": "https://github.com/cusxy/agloom/issues"
  },
  "keywords": [
    "ai",
    "cli",
    "agents",
    "transpiler"
  ],
  "files": [
    "dist",
    "docs/guide",
    "docs/reference"
  ],
  "bin": {
    "agloom": "dist/cli/index.js"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "turbo run build && tsc --noEmit && tsup",
    "test": "turbo run test && vitest run",
    "test:watch": "vitest",
    "fmt": "pnpm run fmt:ts && pnpm run fmt:md",
    "fmt:check": "pnpm run fmt:ts:check && pnpm run fmt:md:check",
    "fmt:ts": "turbo run fmt && prettier --write \"src/**/*.{ts,tsx}\"",
    "fmt:ts:check": "turbo run fmt:check && prettier --check \"src/**/*.{ts,tsx}\"",
    "fmt:md": "agloom format .agloom \"**/AGLOOM.md\" \"docs/**/*.{md,mdx,json,yaml,yml,toml}\"",
    "fmt:md:check": "agloom format --check .agloom \"**/AGLOOM.md\" \"docs/**/*.{md,mdx,json,yaml,yml,toml}\"",
    "lint": "turbo run lint && eslint \"src/**/*.{ts,tsx}\""
  },
  "devDependencies": {
    "@agloom/markdown-tools": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/semver": "^7.7.1",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "ink-testing-library": "^4.0.0",
    "tsup": "^8.5.1",
    "turbo": "^2.5.4",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.58.0",
    "vitest": "^3.1.1"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "dotenv": "^17.3.1",
    "fast-glob": "^3.3.3",
    "gray-matter": "^4.0.3",
    "ink": "^6.8.0",
    "ink-spinner": "^5.0.0",
    "js-yaml": "^4.1.1",
    "jsonc-parser": "^3.3.1",
    "markdownlint-cli2": "^0.17.2",
    "marked": "^14.1.4",
    "marked-terminal": "^7.3.0",
    "prettier": "^3.5.3",
    "prettier-plugin-toml": "^2.0.6",
    "react": "^19.2.4",
    "semver": "^7.7.4",
    "smol-toml": "^1.6.1"
  }
}
