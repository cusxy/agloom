---
import "../styles/tokens.css";
import "../styles/global.css";
import FogBackground from "../components/FogBackground.astro";
import ScrollReveal from "../components/ScrollReveal.astro";

interface Props {
  title: string;
  description: string;
  canonical?: string;
}

const { title, description, canonical = "https://agloom.sh/" } = Astro.props;
const ogImage = "https://agloom.sh/og-image.png";
const cfToken = import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN;
const hasCfToken = typeof cfToken === "string" && cfToken.length > 0;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0a0b0f" />
    <meta name="color-scheme" content="dark" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content="website" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <script is:inline>
      // Gate scroll-reveal starting state before first paint so sections
      // can't flash visible-then-hidden. Skipped for reduced-motion users.
      try {
        if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
          document.documentElement.classList.add("js-reveal");
        }
      } catch (_) {
        /* ignore */
      }
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <FogBackground />
    <div class="shell">
      <slot />
    </div>
    <ScrollReveal />
    {
      hasCfToken && (
        <script
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={`{"token": "${cfToken}"}`}
        />
      )
    }
  </body>
</html>
