---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import EarlyAdopters from "../components/EarlyAdopters.astro";
import Hero from "../components/Hero.astro";
import HeroDemo from "../components/HeroDemo.astro";
import Solution from "../components/Solution.astro";
import FragmentationTax from "../components/FragmentationTax.astro";
import ForTeams from "../components/ForTeams.astro";
import Plugins from "../components/Plugins.astro";
import Formatting from "../components/Formatting.astro";
import WhenItFits from "../components/WhenItFits.astro";
import FAQ from "../components/FAQ.astro";
import CTA from "../components/CTA.astro";
import Footer from "../components/Footer.astro";

const title = "Agloom — One source of truth for every AI coding assistant";
const description =
  "Agloom transpiles a single canonical .agloom/ directory into the exact config files every AI coding assistant in your team expects — Claude Code, Codex, Gemini, OpenCode and more.";
---

<BaseLayout title={title} description={description}>
  <Header />
  <main>
    <Hero />
    <EarlyAdopters />
    <HeroDemo />
    <ForTeams />
    <FragmentationTax />
    <Solution />
    <Plugins />
    <Formatting />
    <WhenItFits />
    <FAQ />
    <CTA />
  </main>
  <Footer />
</BaseLayout>
