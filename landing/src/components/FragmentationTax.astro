---
type Cell = { text: string; none?: boolean };

const rows: { feature: string; agloom: string; claude: Cell; codex: Cell; gemini: Cell; opencode: Cell }[] = [
  {
    feature: "Instructions file",
    agloom: "AGLOOM.md",
    claude: { text: "CLAUDE.md" },
    codex: { text: "AGENTS.md" },
    gemini: { text: "GEMINI.md" },
    opencode: { text: "AGENTS.md" },
  },
  {
    feature: "Skills directory",
    agloom: ".agloom/skills/",
    claude: { text: ".claude/skills/" },
    codex: { text: ".agents/skills/" },
    gemini: { text: ".gemini/skills/" },
    opencode: { text: ".opencode/skills/" },
  },
  {
    feature: "Sub-agents",
    agloom: ".agloom/agents/",
    claude: { text: ".claude/agents/" },
    codex: { text: ".codex/agents/*.toml" },
    gemini: { text: ".gemini/agents/" },
    opencode: { text: ".opencode/agents/" },
  },
  {
    feature: "Slash commands",
    agloom: ".agloom/commands/",
    claude: { text: ".claude/commands/" },
    codex: { text: "via skills" },
    gemini: { text: ".gemini/commands/*.toml" },
    opencode: { text: ".opencode/commands/" },
  },
  {
    feature: "MCP configuration",
    agloom: ".agloom/mcp.yml",
    claude: { text: ".mcp.json" },
    codex: { text: ".codex/config.toml" },
    gemini: { text: ".gemini/settings.json" },
    opencode: { text: "via opencode.json" },
  },
  {
    feature: "Settings / permissions",
    agloom: ".agloom/permissions.yml",
    claude: { text: ".claude/settings.json" },
    codex: { text: ".codex/rules/*.rules" },
    gemini: { text: ".gemini/policies/*.toml" },
    opencode: { text: "via opencode.json" },
  },
  {
    feature: "Reusable plugins",
    agloom: "Canonical format",
    claude: { text: "own format", none: true },
    codex: { text: "own format", none: true },
    gemini: { text: "own format", none: true },
    opencode: { text: "own format", none: true },
  },
  {
    feature: "Variable interpolation",
    agloom: "env · path · variables",
    claude: { text: "env only", none: true },
    codex: { text: "env only", none: true },
    gemini: { text: "env only", none: true },
    opencode: { text: "env only", none: true },
  },
];
---

<section class="frag" data-section="fragmentation">
  <div class="frag__copy">
    <p class="eyebrow">The tax you're paying</p>
    <h2 class="frag__title">Every assistant wants its own format.<br />You're maintaining all of them.</h2>
    <p class="frag__body">
      Modern engineering teams rarely standardise on a single AI assistant.
      Each tool reads its own instruction file, its own skills directory,
      its own settings format. The longer this goes on, the more they
      drift apart — and the more time your team spends keeping them in
      sync by hand.
    </p>
  </div>

  <div class="frag__matrix-wrap">
    <table class="frag__matrix">
      <thead>
        <tr>
          <th scope="col" class="frag__feat-col">Feature</th>
          <th scope="col" class="frag__agloom-col">Agloom</th>
          <th scope="col">Claude</th>
          <th scope="col">Codex</th>
          <th scope="col">Gemini</th>
          <th scope="col">OpenCode</th>
        </tr>
      </thead>
      <tbody>
        {rows.map((row) => (
          <tr>
            <th scope="row" class="frag__feat-col">{row.feature}</th>
            <td class="frag__agloom-col">{row.agloom}</td>
            <td class={row.claude.none ? "none" : ""}>{row.claude.text}</td>
            <td class={row.codex.none ? "none" : ""}>{row.codex.text}</td>
            <td class={row.gemini.none ? "none" : ""}>{row.gemini.text}</td>
            <td class={row.opencode.none ? "none" : ""}>{row.opencode.text}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <p class="frag__caption">
    The Agloom column is written by you. Every other column is generated by
    <code>agloom transpile</code>. See the
    <a href="https://docs.agloom.sh/docs/reference/adapters">full adapter reference →</a>
  </p>
</section>

<style>
  .frag {
    padding: var(--space-20) 0 var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
    align-items: stretch;
  }
  .frag__copy {
    max-width: none;
    text-align: left;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    width: 100%;
  }
  .eyebrow {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-mono-tag);
    text-transform: uppercase;
    color: var(--color-fg-muted);
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
  }
  .eyebrow::before {
    content: "";
    width: 24px;
    height: 1px;
    background: var(--color-accent);
  }
  .frag__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    line-height: 1.05;
    letter-spacing: var(--tracking-display);
    color: var(--color-fg);
    text-wrap: balance;
  }
  .frag__body {
    margin: 0;
    font-family: var(--font-mono);
    color: var(--color-fg-muted);
    font-size: var(--text-sm);
    line-height: 1.7;
  }
  .frag__matrix-wrap {
    /* Break out of the .shell container so the table can use the full viewport. */
    width: 100vw;
    max-width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    /* Compensate parent flex gap so the table sits closer to the heading. */
    margin-top: calc(var(--space-6) - var(--space-10));
    overflow-x: auto;
    padding: 0 var(--space-10);
    /* Soft fade on left/right edges when the table overflows. */
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0,
      #000 var(--space-10),
      #000 calc(100% - var(--space-10)),
      transparent 100%
    );
    mask-image: linear-gradient(
      to right,
      transparent 0,
      #000 var(--space-10),
      #000 calc(100% - var(--space-10)),
      transparent 100%
    );
  }
  .frag__matrix {
    /* Sized to its content so it can extend beyond the shell. */
    width: max-content;
    min-width: min(100%, 1040px);
    margin: 0 auto;
    border-collapse: separate;
    border-spacing: 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: rgba(10, 11, 15, 0.8);
    backdrop-filter: blur(8px);
    overflow: hidden;
  }
  .frag__matrix th,
  .frag__matrix td {
    padding: var(--space-3) var(--space-4);
    text-align: left;
    border-bottom: 1px solid var(--color-rule);
    white-space: nowrap;
  }
  .frag__matrix thead th {
    font-size: var(--text-xxs);
    letter-spacing: var(--tracking-mono-tag);
    text-transform: uppercase;
    color: var(--color-fg-muted);
    background: rgba(6, 8, 16, 0.55);
    font-weight: 500;
  }
  .frag__matrix tbody th {
    font-weight: 500;
    color: var(--color-fg);
  }
  .frag__matrix tbody tr:last-child th,
  .frag__matrix tbody tr:last-child td {
    border-bottom: 0;
  }
  .frag__matrix tbody td {
    color: var(--color-fg);
  }
  .frag__matrix tbody td.none {
    color: var(--color-fg-muted);
  }
  .frag__feat-col {
    position: sticky;
    left: 0;
    background: rgba(10, 11, 15, 0.95);
    z-index: 1;
  }
  .frag__matrix thead .frag__feat-col {
    background: rgba(6, 8, 16, 0.95);
  }
  .frag__agloom-col {
    background: rgba(38, 28, 74, 0.35) !important;
    color: var(--color-spark) !important;
    border-left: 1px solid rgba(136, 164, 196, 0.35);
    border-right: 1px solid rgba(136, 164, 196, 0.35);
  }
  .frag__matrix thead .frag__agloom-col {
    color: var(--color-spark) !important;
  }
  .frag__caption {
    /* Compensate parent flex gap so the caption sits closer to the table. */
    margin: calc(var(--space-6) - var(--space-10)) 0 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-fg-muted);
    text-align: center;
    line-height: 1.7;
  }
</style>
