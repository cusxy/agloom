---
type Diff = "del" | "ins";
type DiffRow = { text: string; diff?: Diff };

const beforeRows: DiffRow[] = [
  { text: "#   My Project", diff: "del" },
  { text: "" },
  { text: "", diff: "del" },
  { text: "## Stack" },
  { text: "" },
  { text: "*  TypeScript", diff: "del" },
  { text: "*   React", diff: "del" },
  { text: "-  PostgreSQL", diff: "del" },
  { text: " - Next.js 14", diff: "del" },
  { text: "" },
  { text: "## Conventions" },
  { text: "-  Server components by default.", diff: "del" },
  { text: "*  Prisma for all queries.", diff: "del" },
  { text: "## Boundaries" },
  { text: "- Never skip strict mode." },
  { text: "- No raw SQL in `generated/`." },
];

const afterRows: DiffRow[] = [
  { text: "# My Project", diff: "ins" },
  { text: "" },
  { text: "## Stack" },
  { text: "" },
  { text: "- TypeScript", diff: "ins" },
  { text: "- React", diff: "ins" },
  { text: "- PostgreSQL", diff: "ins" },
  { text: "- Next.js 14", diff: "ins" },
  { text: "" },
  { text: "## Conventions" },
  { text: "", diff: "ins" },
  { text: "- Server components by default.", diff: "ins" },
  { text: "- Prisma for all queries.", diff: "ins" },
  { text: "" },
  { text: "## Boundaries" },
  { text: "", diff: "ins" },
  { text: "- Never skip strict mode." },
  { text: "- No raw SQL in `generated/`." },
];
---

<section class="fmt" data-section="formatting">
  <div class="fmt__head">
    <p class="eyebrow">Formatting</p>
    <h2 class="fmt__title">Ship canonical files that look canonical.</h2>
  </div>

  <div class="fmt__intro">
    <p class="fmt__body">
      Agloom ships with <code>agloom format</code> — a pre-configured
      wrapper around prettier and markdownlint. It targets
      <code>.agloom/**/*</code> and <code>**/AGLOOM.md</code> by default.
      No config to install, no linter plugins to wire up. Run it as a
      pre-commit hook or manually before <code>agloom transpile</code>.
    </p>

    <div class="fmt__terminal" aria-label="Terminal example">
      <div class="fmt__terminal-head">
        <span class="traffic traffic--red" aria-hidden="true"></span>
        <span class="traffic traffic--yellow" aria-hidden="true"></span>
        <span class="traffic traffic--green" aria-hidden="true"></span>
        <span class="fmt__terminal-title">zsh — ~/your-project</span>
      </div>
      <div class="fmt__terminal-body">
        <div class="tline"><span class="tprompt">$</span> <code>agloom format</code></div>
        <div class="tline tline--comment"># write mode (default)</div>
        <div class="tline tline--blank">&nbsp;</div>
        <div class="tline"><span class="tprompt">$</span> <code>agloom format --check</code></div>
        <div class="tline tline--comment"># CI mode, exits non-zero if unformatted</div>
      </div>
    </div>
  </div>

  <div class="fmt__grid">
    <div class="pane">
      <div class="pane__head">
        <span class="pane__label">Before</span>
        <span class="pane__path">AGLOOM.md</span>
      </div>
      <pre class="fmt__code"><div class="drows">{beforeRows.map((r) => {
        const cls = r.diff ? `drow drow--${r.diff}` : "drow";
        return (<div class={cls}><span class="dtxt">{r.text || " "}</span></div>);
      })}</div></pre>
    </div>
    <div class="pane">
      <div class="pane__head">
        <span class="pane__label">After</span>
        <span class="pane__path">AGLOOM.md</span>
      </div>
      <pre class="fmt__code"><div class="drows">{afterRows.map((r) => {
        const cls = r.diff ? `drow drow--${r.diff}` : "drow";
        return (<div class={cls}><span class="dtxt">{r.text || " "}</span></div>);
      })}</div></pre>
    </div>
  </div>

  <p class="fmt__caption">
    Supports <code>.md</code>, <code>.json</code>, <code>.yaml</code>,
    <code>.toml</code>. Configurable via <code>.prettierrc.*</code>,
    <code>.markdownlint.*</code>, or a <code>prettier</code> /
    <code>markdownlint</code> section in <code>.agloom/config.yml</code>.
    <a href="https://docs.agloom.sh/docs/guide/formatting">Full formatting guide →</a>
  </p>
</section>

<style>
  .fmt {
    padding: var(--space-20) 0 var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }
  .fmt__head {
    max-width: none;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .eyebrow {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-mono-tag);
    text-transform: uppercase;
    color: var(--color-fg-muted);
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
  }
  .eyebrow::before {
    content: "";
    width: 24px;
    height: 1px;
    background: var(--color-accent);
  }
  .fmt__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    line-height: 1.05;
    letter-spacing: var(--tracking-display);
    color: var(--color-fg);
    text-wrap: balance;
  }
  .fmt__body {
    margin: 0;
    font-family: var(--font-mono);
    color: var(--color-fg-muted);
    font-size: var(--text-sm);
    line-height: 1.7;
  }

  .fmt__intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-6);
    align-items: start;
  }

  .fmt__terminal {
    background: rgba(6, 8, 16, 0.85);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.04) inset,
      0 24px 60px -30px rgba(0, 0, 0, 0.8);
    backdrop-filter: blur(8px);
  }
  .fmt__terminal-head {
    position: relative;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px var(--space-4);
    background: linear-gradient(180deg, rgba(28, 30, 38, 0.95), rgba(18, 20, 28, 0.95));
    border-bottom: 1px solid var(--color-rule);
  }
  .traffic {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    display: inline-block;
    flex-shrink: 0;
  }
  .traffic--red { background: #ff5f57; box-shadow: 0 0 0 0.5px rgba(0, 0, 0, 0.35); }
  .traffic--yellow { background: #febc2e; box-shadow: 0 0 0 0.5px rgba(0, 0, 0, 0.35); }
  .traffic--green { background: #28c840; box-shadow: 0 0 0 0.5px rgba(0, 0, 0, 0.35); }
  .fmt__terminal-title {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    font-family: var(--font-mono);
    font-size: var(--text-xxs);
    letter-spacing: 0.02em;
    color: var(--color-fg-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 60%;
  }
  .fmt__terminal-body {
    padding: var(--space-4) var(--space-5);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    line-height: 1.75;
    color: var(--color-fg);
  }
  .tline {
    white-space: pre;
    min-height: 1.75em;
  }
  .tline code {
    background: transparent;
    border: 0;
    padding: 0;
    color: var(--color-spark);
    font-size: inherit;
  }
  .tprompt {
    color: var(--color-warm);
    user-select: none;
    margin-right: 0.4em;
  }
  .tline--comment {
    color: var(--color-fg-muted);
    padding-left: 1.2em;
  }
  .tline--blank {
    user-select: none;
  }
  .fmt__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6);
  }
  .pane {
    background: rgba(10, 11, 15, 0.8);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    backdrop-filter: blur(8px);
  }
  .pane__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-2) var(--space-4);
    border-bottom: 1px solid var(--color-rule);
    background: rgba(6, 8, 16, 0.55);
  }
  .pane__label {
    font-family: var(--font-mono);
    font-size: var(--text-xxs);
    letter-spacing: var(--tracking-mono-tag);
    text-transform: uppercase;
    color: var(--color-fg);
  }
  .pane__path {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--color-fg-muted);
  }
  .fmt__code {
    margin: 0;
    padding: var(--space-4) 0;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    line-height: 1.7;
    color: var(--color-fg);
    overflow-x: auto;
    white-space: pre;
  }
  .fmt__code .drows {
    display: inline-block;
    min-width: 100%;
    box-sizing: border-box;
  }
  .fmt__code .drow {
    padding: 0 var(--space-5) 0 calc(var(--space-5) - 3px);
    border-left: 3px solid var(--color-rule);
    background: rgba(122, 126, 140, 0.05);
  }
  .fmt__code .drow--del {
    border-left-color: #d47a9b;
    background: rgba(212, 122, 155, 0.10);
  }
  .fmt__code .drow--del .dtxt { color: #e0a7bf; }
  .fmt__code .drow--ins {
    border-left-color: #70c4b8;
    background: rgba(112, 196, 184, 0.10);
  }
  .fmt__code .drow--ins .dtxt { color: #9bd4cb; }

  .fmt__caption {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-fg-muted);
    line-height: 1.7;
    text-align: center;
  }
  .fmt__caption code { font-size: 0.9em; }

  @media (max-width: 820px) {
    .fmt__grid { grid-template-columns: 1fr; }
    .fmt__intro { grid-template-columns: 1fr; }
  }
</style>
